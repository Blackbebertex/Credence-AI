# Synthetic local development only. Replace every value with out-of-repository secrets.
ENV=dev
CELL_ID=local-simulated
POSTGRES_DB=credence
POSTGRES_USER=credence
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://credence:change-me-local-only@postgres:5432/credence
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=credence-local
MINIO_ROOT_PASSWORD=change-me-local-only
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=credence-local
S3_SECRET_KEY=change-me-local-only
KEYCLOAK_ISSUER=http://keycloak:8080/realms/credence-dev
KEYCLOAK_AUDIENCE=credence-api
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEK_PATH=/run/secrets/dev-kek
SIGNING_KEY_PATH=/run/secrets/dev-ed25519.pem
SIGNING_PUBKEY_PATH=/run/secrets/dev-ed25519.pub
LLM_PROVIDER=mock
LLM_ALLOW_EXTERNAL=false
LLM_API_KEY=
LIVE_SEARCH_ENABLED=false
MAX_UPLOAD_MB=10
